        "#| label: piramide-plotly\n",
        "#| echo: false\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "import pandas as pd\n",
        "import json\n",
        "\n",
        "with open(\"data/piramide_dep.json\", encoding=\"utf-8\") as f:\n",
        "    raw = json.load(f)\n",
        "\n",
        "df = pd.DataFrame(raw)\n",
        "df.columns = [\"depto\", \"año\", \"area\", \"grupo\", \"orden\", \"h\", \"m\", \"total_pob\"]\n",
        "df = df[df[\"area\"] == \"Total\"].copy()\n",
        "df[\"año\"] = df[\"año\"].astype(int)\n",
        "\n",
        "orden_grupos = [\n",
        "    \"0 - 4\",\"5 - 9\",\"10 - 14\",\"15 - 19\",\"20 - 24\",\"25 - 29\",\n",
        "    \"30 - 34\",\"35 - 39\",\"40 - 44\",\"45 - 49\",\"50 - 54\",\"55 - 59\",\n",
        "    \"60 - 64\",\"65 - 69\",\"70 - 74\",\"75 - 79\",\"80 +\"\n",
        "]\n",
        "\n",
        "departamentos = sorted(df[\"depto\"].unique())\n",
        "años = sorted(df[\"año\"].unique())\n",
        "init_dept = \"Córdoba\"\n",
        "init_idx  = departamentos.index(init_dept)\n",
        "init_year = años[0]\n",
        "\n",
        "def pct_h_m(depto, año):\n",
        "    sub = df[(df[\"depto\"] == depto) & (df[\"año\"] == año)].sort_values(\"orden\")\n",
        "    tot = int(sub[\"total_pob\"].iloc[0])\n",
        "    ph = [-r / tot * 100 for r in sub[\"h\"]]\n",
        "    pm = [ r / tot * 100 for r in sub[\"m\"]]\n",
        "    return ph, pm, tot\n",
        "\n",
        "# --- Trazas: 2 por departamento (66 en total) ---\n",
        "traces = []\n",
        "for i, depto in enumerate(departamentos):\n",
        "    ph, pm, _ = pct_h_m(depto, init_year)\n",
        "    vis = (i == init_idx)\n",
