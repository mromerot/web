        "    .attr(\"d\", line)\n",
        "    .attr(\"fill\", \"rgba(50,150,250,0.5)\")\n",
        "    .attr(\"stroke\", \"steelblue\")\n",
        "    .attr(\"stroke-width\", 2);\n",
        "\n",
        "  return svg.node();\n",
        "}\n",
